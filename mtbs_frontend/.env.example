# CRA only exposes vars prefixed REACT_APP_ to the bundle, and inlines them at
# BUILD time — rebuild after changing anything here.
#
# By default the API client uses a SAME-ORIGIN /api/ path (no host baked in):
#   - dev:  the "proxy" field in package.json forwards /api/* to Django on :8000
#   - prod: the Vercel rewrite in vercel.json proxies /api/* to the Render backend
# So local dev and production both work with NOTHING set here.
#
# Optional escape hatch: set REACT_APP_API_ROOT to an ABSOLUTE origin (with a
# trailing /api/) to bypass the proxy and call a backend directly. A trailing
# slash is optional; the client normalises it.
# REACT_APP_API_ROOT=http://localhost:8000/api/

# WebSockets (live seat updates) can't go through the HTTP proxy, so the socket
# connects DIRECTLY to the backend. You do NOT need to set this: the Render host
# is baked into the client (src/api/axios.js), so a deployed build uses
# wss://cinemora-6r4q.onrender.com/ws/ and local dev uses ws://localhost:8000/ws/.
# Set it only to override that default (e.g. point at a different backend).
# REACT_APP_WS_ROOT=wss://cinemora-6r4q.onrender.com/ws/

# Keep source maps out of production builds (smaller, and doesn't ship source).
GENERATE_SOURCEMAP=false
