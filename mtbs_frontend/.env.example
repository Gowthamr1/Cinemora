# Copy to .env and adjust. CRA only exposes vars prefixed REACT_APP_ to the
# bundle, and inlines them at BUILD time — rebuild after changing anything here.

# Base URL of the Django API, including the trailing /api/. A trailing slash is
# optional (the client normalises it). The WebSocket origin for live seat
# updates is derived from this (http->ws, /api/ -> /ws/), so it always follows
# the API host. Leave unset to default to http://localhost:8000/api/ for local dev.
APP_API_ROOT=http://localhost:8000/api/

# Keep source maps out of production builds (smaller, and doesn't ship source).
GENERATE_SOURCEMAP=false
