{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path+/",
      "destination": "https://cinemora-6r4q.onrender.com/api/:path+/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://cinemora-6r4q.onrender.com/api/:path*"
    },
    {
      "source": "/api",
      "destination": "https://cinemora-6r4q.onrender.com/api/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
