# Copy to .env and fill in. This file documents every variable settings.py
# reads; never commit the real .env (it is gitignored). Do NOT put real
# secrets in this example file.

# --- Required -------------------------------------------------------------

# Postgres/Neon connection string. Django refuses to start without it.
NEON_DB_STRING=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Signs sessions and JWTs. Required when DJANGO_DEBUG is off; a missing key is
# tolerated only with DEBUG on (a fresh clone runs without setup).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# --- Core -----------------------------------------------------------------

# Debug tracebacks leak settings and SQL. Never true in production.
DJANGO_DEBUG=True

# Comma-separated hostnames Django will serve. Required with DEBUG off (empty
# rejects every request). Dev defaults to localhost,127.0.0.1,[::1].
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF ----------------------------------------------------------

# Comma-separated origins the browser may call the API from (exact scheme+host
# +port, no wildcard — credentials are sent). Defaults to http://localhost:3000.
DJANGO_CORS_ORIGINS=http://localhost:3000

# Origins trusted for unsafe (write) requests. Defaults to DJANGO_CORS_ORIGINS.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# SameSite for the auth cookies. 'Lax' when frontend and API share a site
# (any localhost port does). Cross-domain production needs 'None' (plus HTTPS).
DJANGO_AUTH_COOKIE_SAMESITE=Lax

# Set only if the frontend and API live on different subdomains of one domain
# (e.g. .example.com) so both can read the csrftoken cookie. Leave blank otherwise.
DJANGO_CSRF_COOKIE_DOMAIN=

# --- Optional infrastructure ----------------------------------------------

# Channels layer for cross-process WebSocket broadcasts. Unset uses in-memory
# (single process only). Set when running more than one worker.
REDIS_URL=

# Shared cache (throttle counters, filter-options cache). Unset uses per-process
# LocMem. Point at Redis to share across processes.
CACHE_URL=

# How long the movie filter dropdown options may be cached, in seconds.
FILTER_OPTIONS_CACHE_SECONDS=300

# --- Rate limits (DRF throttles) ------------------------------------------
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_VERIFY=60/min

# --- Production hardening (only read when DJANGO_DEBUG is off) -------------

# Redirect HTTP to HTTPS. Defaults on with DEBUG off.
DJANGO_SECURE_SSL_REDIRECT=True

# HSTS max-age in seconds. Starts at an hour so a bad deploy is recoverable.
DJANGO_HSTS_SECONDS=3600

# Set true when Django runs behind a reverse proxy that terminates TLS, so it
# trusts X-Forwarded-Proto to detect the original HTTPS request.
DJANGO_BEHIND_PROXY=False
